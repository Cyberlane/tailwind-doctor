{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "tw-doctor",
          "version": "dev",
          "informationUri": "https://github.com/Cyberlane/tailwind-doctor",
          "rules": [
            {
              "id": "no-arbitrary-value",
              "name": "no-arbitrary-value",
              "shortDescription": {
                "text": "no-arbitrary-value (consistency)"
              },
              "helpUri": "https://github.com/Cyberlane/tailwind-doctor/blob/main/docs/rules.md#no-arbitrary-value",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "category": "consistency",
                "exposure": "utility",
                "confidence": "high"
              }
            },
            {
              "id": "no-conflicting-utilities",
              "name": "no-conflicting-utilities",
              "shortDescription": {
                "text": "no-conflicting-utilities (correctness)"
              },
              "helpUri": "https://github.com/Cyberlane/tailwind-doctor/blob/main/docs/rules.md#no-conflicting-utilities",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "category": "correctness",
                "exposure": "utility",
                "confidence": "high"
              }
            },
            {
              "id": "responsive-bloat",
              "name": "responsive-bloat",
              "shortDescription": {
                "text": "responsive-bloat (maintainability)"
              },
              "helpUri": "https://github.com/Cyberlane/tailwind-doctor/blob/main/docs/rules.md#responsive-bloat",
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "category": "maintainability",
                "exposure": "class-list",
                "confidence": "medium"
              }
            },
            {
              "id": "unused-token",
              "name": "unused-token",
              "shortDescription": {
                "text": "unused-token (consistency)"
              },
              "helpUri": "https://github.com/Cyberlane/tailwind-doctor/blob/main/docs/rules.md#unused-token",
              "defaultConfiguration": {
                "level": "none"
              },
              "properties": {
                "category": "consistency",
                "exposure": "token",
                "confidence": "high"
              }
            },
            {
              "id": "color-contrast",
              "name": "color-contrast",
              "shortDescription": {
                "text": "color-contrast (accessibility)"
              },
              "helpUri": "https://github.com/Cyberlane/tailwind-doctor/blob/main/docs/rules.md#color-contrast",
              "defaultConfiguration": {
                "level": "none"
              },
              "properties": {
                "category": "accessibility",
                "exposure": "color-pair",
                "confidence": "high"
              }
            }
          ]
        }
      },
      "invocations": [
        {
          "executionSuccessful": true,
          "toolExecutionNotifications": []
        }
      ],
      "results": [
        {
          "ruleId": "unused-token",
